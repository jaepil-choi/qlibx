# Python-generated files
__pycache__/
.pytest_cache/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# The workspace directory the CLI writes: catalog, object store, materialized frames. It is
# derived state rebuilt from declarations, so a committed copy is a stale answer.
.vqapr/

/data/
outputs/
experiments/outputs/
showcases/outputs/
experiments/exp_*/outputs/
showcases/show_*/outputs/
.agent/runs/*
!.agent/runs/.gitignore

# Local test and tool scratch state.
/.codex-tmp/
/.ruff_cache/
/.uv-cache*/
/.agent/test-runs/
/.agent/tmp/
/.tmp/
/tmp/

# Agent execution plans are local working state.
/.agent/plans/**
!/.agent/plans/active/
!/.agent/plans/active/.gitkeep
!/.agent/plans/completed/
!/.agent/plans/completed/.gitkeep

# GJC workflow state is per-session local scratch, never shared.
/.gjc/
/.gjc-evidence/

# The installed-package testbed is a MEASUREMENT workspace, not source: a generated .vqapr/
# catalog, parquet fixtures, a run record, and scaffolds emitted by the CLI under test. Its whole
# point is to be rebuilt from scratch by a first-time user, so a committed copy would be a stale
# answer to a question the next run has to ask again. Only its rules file is worth keeping.
/testbed/**
!/testbed/AGENTS.md

# Agent tooling scratch. This is a Python package: a node dependency tree here belongs to the
# harness that drove a session, never to the distribution, and `git add -A` will otherwise sweep
# 101MB of it into a commit.
/node_modules/
/package.json
/bun.lock
